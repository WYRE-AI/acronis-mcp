# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
# ACRONIS_BASE_URL must be https and its hostname must end with .acronis.com.
ACRONIS_BASE_URL=https://us5-cloud.acronis.com
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=

# Write tools (mark_alert_as_false_positive, update_investigation_state,
# execute_a_protection_policy) are hidden and refused unless this is exactly "true".
ACRONIS_ENABLE_WRITES=false

# Upstream child-process pool (one child per credential tuple).
# ACRONIS_POOL_MAX=50
# ACRONIS_POOL_IDLE_MS=600000

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: X-Acronis-Base-Url / X-Acronis-Client-Id / X-Acronis-Client-Secret on
#          each /mcp request. Never falls back to ACRONIS_*. Docker image and
#          Compose default.
# env:     use ACRONIS_* after X-Gateway-S2S verifies.
AUTH_MODE=gateway

# Required to start the HTTP transport. Leave this empty. The process exits
# if it is empty or a known placeholder (so a copied example cannot forge
# X-Gateway-S2S). Compose will not start when it is unset or empty.
# Generate a value with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The process logs a warning, does not check
# X-Gateway-S2S, and binds 127.0.0.1 only — a wider MCP_HTTP_HOST such as
# 0.0.0.0 is ignored. A placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Defaults to 127.0.0.1
# when unset. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

LOG_LEVEL=info
